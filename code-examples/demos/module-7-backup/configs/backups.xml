<?xml version="1.0"?>
<!--
  Backup destination config. Mounted at runtime by run.sh into
  /etc/clickhouse-server/config.d/ on clickhouse-single.

  Defines a 'backups' disk so BACKUP TO Disk('backups', '...') works.
-->
<config>
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/var/lib/clickhouse/backups/</path>
            </backups>
        </disks>
    </storage_configuration>

    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/var/lib/clickhouse/backups/</allowed_path>
    </backups>
</config>
