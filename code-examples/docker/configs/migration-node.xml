<?xml version="1.0"?>
<!-- ClickHouse Configuration for Migration (legacy) -->
<!-- Optimized for receiving data from multiple sources via Debezium/Kafka -->

<config>
    <!-- Logger configuration -->
    <logger>
        <level>notice</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>

    <!-- System tables logging -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
    </query_log>

    <part_log>
        <database>system</database>
        <table>part_log</table>
    </part_log>

    <!-- Memory settings optimized for data ingestion -->
    <max_memory_usage>4294967296</max_memory_usage>
    <max_memory_usage_for_user>3758096384</max_memory_usage_for_user>

    <!-- Compression settings -->
    <compression>
        <case>
            <min_part_size>10000000</min_part_size>
            <min_part_size_ratio>0.01</min_part_size_ratio>
            <method>lz4</method>
        </case>
    </compression>

    <!-- Network settings -->
    <listen_host>0.0.0.0</listen_host>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <interserver_http_port>9009</interserver_http_port>

    <!-- Performance tuning for high-throughput ingestion -->
    <max_connections>4096</max_connections>
    <keep_alive_timeout>3</keep_alive_timeout>

    <!-- Background pool settings -->
    <background_pool_size>48</background_pool_size>
    <background_schedule_pool_size>48</background_schedule_pool_size>

    <!-- Merge tree settings -->
    <merge_tree>
        <max_parts_in_queue>1000</max_parts_in_queue>
        <number_of_free_entries_in_pool_to_execute_mutation>10</number_of_free_entries_in_pool_to_execute_mutation>
        <replicated_deduplication_window>0</replicated_deduplication_window>
        <replicated_deduplication_window_seconds>0</replicated_deduplication_window_seconds>
    </merge_tree>

    <!-- Kafka settings for CDC -->
    <kafka>
        <num_threads>4</num_threads>
        <flush_interval_ms>5000</flush_interval_ms>
        <flush_on_rows>50000</flush_on_rows>
        <max_retries>30</max_retries>
    </kafka>

    <!-- Quotas -->
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>

    <!-- Default profile -->
    <default_profile>default</default_profile>

    <!-- Storage paths -->
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>

    <!-- Format schema paths -->
    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>

</config>
