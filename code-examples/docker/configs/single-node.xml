<?xml version="1.0"?>
<!-- ClickHouse Single Node Configuration -->
<!-- Purpose: Optimized settings for single-node development environment -->

<config>
    <!-- Logger configuration -->
    <logger>
        <level>notice</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>

    <!-- Query processing settings -->
    <query_thread_log>
        <database>system</database>
        <table>query_thread_log</table>
    </query_thread_log>

    <query_log>
        <database>system</database>
        <table>query_log</table>
    </query_log>

    <!-- Memory settings -->
    <max_memory_usage>2147483648</max_memory_usage>
    <max_memory_usage_for_user>1610612736</max_memory_usage_for_user>
    <max_rows_to_read>0</max_rows_to_read>
    <max_bytes_to_read>0</max_bytes_to_read>

    <!-- Compression settings -->
    <compression>
        <case>
            <min_part_size>10000000</min_part_size>
            <min_part_size_ratio>0.01</min_part_size_ratio>
            <method>lz4</method>
        </case>
    </compression>

    <!-- Network settings -->
    <listen_host>0.0.0.0</listen_host>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <https_port>8443</https_port>
    <tcp_ssl_port>9440</tcp_ssl_port>
    <interserver_http_port>9009</interserver_http_port>

    <!-- Performance tuning -->
    <max_connections>4096</max_connections>
    <keep_alive_timeout>3</keep_alive_timeout>

    <!-- Background pool settings -->
    <background_pool_size>16</background_pool_size>
    <background_schedule_pool_size>16</background_schedule_pool_size>

    <!-- Merge tree settings -->
    <merge_tree>
        <replicated_fetches_http_connection_timeout>0</replicated_fetches_http_connection_timeout>
        <replicated_fetches_http_read_timeout>0</replicated_fetches_http_read_timeout>
        <replicated_fetches_http_connect_timeout>0</replicated_fetches_http_connect_timeout>
    </merge_tree>

    <!-- Quotas for users (optional) -->
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>

    <!-- Default profile settings -->
    <default_profile>default</default_profile>

    <!-- Dictionaries configuration -->
    <dictionaries_config>*_dictionary.xml</dictionaries_config>

    <!-- Enable distributed DDL -->
    <distributed_ddl>
        <profile>default</profile>
    </distributed_ddl>

    <!-- Storage paths -->
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>

    <!-- Format schema paths -->
    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>

</config>
