<?xml version="1.0"?>
<!-- ClickHouse Configuration for Kafka Integration (Module 9) -->

<config>
    <!-- Logger configuration -->
    <logger>
        <level>notice</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>

    <!-- System tables logging -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
    </query_log>

    <!-- Memory settings -->
    <max_memory_usage>3221225472</max_memory_usage>
    <max_memory_usage_for_user>2684354560</max_memory_usage_for_user>

    <!-- Compression settings -->
    <compression>
        <case>
            <min_part_size>10000000</min_part_size>
            <min_part_size_ratio>0.01</min_part_size_ratio>
            <method>lz4</method>
        </case>
    </compression>

    <!-- Network settings -->
    <listen_host>0.0.0.0</listen_host>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <interserver_http_port>9009</interserver_http_port>

    <!-- Performance tuning -->
    <max_connections>4096</max_connections>
    <keep_alive_timeout>3</keep_alive_timeout>

    <!-- Background pool settings for stream processing -->
    <background_pool_size>32</background_pool_size>
    <background_schedule_pool_size>32</background_schedule_pool_size>

    <!-- Kafka settings -->
    <kafka>
        <!-- Default group ID for consumers -->
        <group_id>clickhouse_consumers</group_id>

        <!-- Number of consumer threads -->
        <num_threads>2</num_threads>

        <!-- Flush timeout in milliseconds -->
        <flush_interval_ms>7500</flush_interval_ms>

        <!-- Maximum rows in batch before flushing -->
        <flush_on_rows>10000</flush_on_rows>

        <!-- Retry settings -->
        <max_retries>30</max_retries>
        <retry_backoff_ms>100</retry_backoff_ms>
    </kafka>

    <!-- Quotas -->
    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>

    <!-- Default profile -->
    <default_profile>default</default_profile>

    <!-- Storage paths -->
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>

    <!-- Format schema paths -->
    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>

    <!-- Distributed DDL -->
    <distributed_ddl>
        <profile>default</profile>
    </distributed_ddl>

</config>
