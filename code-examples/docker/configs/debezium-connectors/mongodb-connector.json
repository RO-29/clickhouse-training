{
  "name": "mongodb-connector",
  "config": {
    "connector.class": "io.debezium.connector.mongodb.MongoDbConnector",
    "mongodb.hosts": "mongodb:27017",
    "mongodb.name": "dbserver",
    "mongodb.user": "root",
    "mongodb.password": "password",
    "database.include.list": "source_db",
    "collection.include.list": "source_db.users,source_db.orders,source_db.products",
    "topics.prefix": "mongodb",
    "topic.creation.enable": true,
    "topic.creation.default.replication.factor": 1,
    "topic.creation.default.partitions": 3,
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "([^.]+)\\.([^.]+)\\.([^.]+)",
    "transforms.route.replacement": "$1.$2.$3",
    "output.key.format": "json",
    "output.value.format": "json",
    "decimal.handling.mode": "string",
    "include.unknown.datatypes": true,
    "enable.snapshot": true,
    "snapshot.mode": "initial",
    "snapshot.fetch.size": 1000,
    "poll.interval.ms": 1000,
    "snapshot.delay.ms": 10000,
    "snapshot.max.threads": 1,
    "batch.size": 2048,
    "poll.interval.ms": 3000,
    "connect.backoff.initial.delay.ms": 100,
    "connect.backoff.max.delay.ms": 10000,
    "connect.max.attempts": 3,
    "connection.timeout.ms": 10000,
    "server.selection.timeout.ms": 5000,
    "heartbeat.interval.ms": 30000,
    "heartbeat.timeout.ms": 10000,
    "socket.timeout.ms": 0,
    "schema.history.internal.kafka.bootstrap.servers": "kafka:29092",
    "schema.history.internal.kafka.topic": "dbhistory.source_db",
    "schema.history.internal.consumer.allow.auto.create.topics": true,
    "schema.name.adjustment.mode": "avro",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": true,
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": true
  }
}
