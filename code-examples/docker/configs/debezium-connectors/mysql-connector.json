{
  "name": "mysql-connector",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "mysql",
    "database.port": 3306,
    "database.user": "debezium_user",
    "database.password": "debezium_password",
    "database.server.id": 184054,
    "database.server.name": "mysql",
    "database.include.list": "source_db",
    "table.include.list": "source_db.customers,source_db.products,source_db.sales,source_db.inventory",
    "database.history.kafka.bootstrap.servers": "kafka:29092",
    "database.history.kafka.topic": "dbhistory.mysql",
    "database.history.consumer.bootstrap.servers": "kafka:29092",
    "database.history.producer.bootstrap.servers": "kafka:29092",
    "topic.creation.enable": true,
    "topic.creation.default.replication.factor": 1,
    "topic.creation.default.partitions": 3,
    "topic.prefix": "mysql",
    "snapshot.mode": "initial",
    "snapshot.fetch.size": 2048,
    "snapshot.locking.mode": "minimal",
    "include.schema.changes": true,
    "include.query": false,
    "decimal.handling.mode": "precise",
    "bigint.unsigned.handling.mode": "long",
    "time.precision.mode": "connect",
    "max.batch.size": 2048,
    "max.queue.size": 8192,
    "poll.interval.ms": 1000,
    "connect.timeout.ms": 30000,
    "connect.keep.alive": true,
    "connect.keep.alive.interval.ms": 60000,
    "retriable.restart.connector.wait.time.ms": 5000,
    "event.deserialization.failure.handling.mode": "warn",
    "inconsistent.schema.handling.mode": "fail",
    "enable.time.adjuster": true,
    "enable.snapshot.ddl": false,
    "column.truncate.to.length.chars": false,
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "([^.]+)\\.([^.]+)\\.([^.]+)",
    "transforms.route.replacement": "$1.$2.$3",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": true,
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": true
  }
}
