# Docker Compose Environment Configuration
# Copy this file to .env and customize for your environment

# Project Configuration
COMPOSE_PROJECT_NAME=clickhouse-ks

# ClickHouse Configuration
CLICKHOUSE_VERSION=latest
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Resource Limits (for docker-compose)
MEMORY_LIMIT=4g
CPUS_LIMIT=2

# Kafka Configuration
KAFKA_VERSION=7.5.0
KAFKA_BROKERS=kafka:29092
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1
KAFKA_LOG_RETENTION_HOURS=24

# ZooKeeper Configuration
ZOOKEEPER_VERSION=latest
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_INIT_LIMIT=5
ZOOKEEPER_SYNC_LIMIT=2

# MongoDB Configuration (Migration)
MONGODB_VERSION=latest
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=source_db

# MySQL Configuration (Migration)
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=source_db
MYSQL_USER=dbuser
MYSQL_PASSWORD=dbpassword

# Debezium Configuration
DEBEZIUM_VERSION=latest
DEBEZIUM_CONNECTOR_CLASS_MONGODB=io.debezium.connector.mongodb.MongoDbConnector
DEBEZIUM_CONNECTOR_CLASS_MYSQL=io.debezium.connector.mysql.MySqlConnector

# Prometheus Configuration
PROMETHEUS_VERSION=latest
PROMETHEUS_RETENTION=15d
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# Grafana Configuration
GRAFANA_VERSION=latest
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_password
GF_USERS_ALLOW_SIGN_UP=false
GF_INSTALL_PLUGINS=grafana-piechart-panel

# AlertManager Configuration
ALERTMANAGER_VERSION=latest

# Node Exporter Configuration
NODE_EXPORTER_VERSION=latest

# cAdvisor Configuration
CADVISOR_VERSION=latest

# Port Configuration
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_INTERSERVER_PORT=9009
KAFKA_PORT=9092
KAFKA_CONTROLLER_PORT=29092
ZOOKEEPER_PORT=2181
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8085
KAFKA_UI_PORT=8080

# Network Configuration
NETWORK_SUBNET=172.20.0.0/16
NETWORK_DRIVER=bridge

# Logging Configuration
LOG_LEVEL=notice
LOG_SIZE=1000M
LOG_COUNT=10

# Development/Production Settings
ENVIRONMENT=development
DEBUG=false

# SSL/TLS Configuration (optional)
# ENABLE_SSL=false
# SSL_CERT_PATH=/path/to/cert
# SSL_KEY_PATH=/path/to/key

# Database Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7

# Performance Tuning
# Single node
SINGLE_NODE_MAX_MEMORY=2g
SINGLE_NODE_BACKGROUND_POOL_SIZE=16

# Cluster nodes
CLUSTER_NODE_MAX_MEMORY=2g
CLUSTER_NODE_BACKGROUND_POOL_SIZE=32

# Kafka node
KAFKA_NODE_MAX_MEMORY=3g
KAFKA_NODE_BACKGROUND_POOL_SIZE=32

# Monitoring node
MONITORING_NODE_MAX_MEMORY=3g
MONITORING_NODE_BACKGROUND_POOL_SIZE=24

# Migration stack
MIGRATION_NODE_MAX_MEMORY=4g
MIGRATION_NODE_BACKGROUND_POOL_SIZE=48

# Feature Flags
ENABLE_KAFKA_INTEGRATION=true
ENABLE_MONITORING=true
ENABLE_MIGRATION_STACK=true
ENABLE_CLUSTER=true

# Advanced Settings
QUERY_LOG_ENABLED=true
PART_LOG_ENABLED=true
QUERY_THREAD_LOG_ENABLED=true
METRIC_LOG_ENABLED=true

# Custom ClickHouse Settings
CLICKHOUSE_MAX_QUERY_SIZE=262144
CLICKHOUSE_MAX_ROWS_TO_READ=0
CLICKHOUSE_MAX_BYTES_TO_READ=0
CLICKHOUSE_READONLY=0
