<?xml version="1.0"?>
<yandex>
    <!--
    ClickHouse Server Configuration File
    Production-ready configuration with clustering, replication, and ZooKeeper support

    NOTE: This is the main configuration file. Changes require server restart.
    Some settings can also be changed in users.xml or via SET commands
    -->

    <!--
    ============================================
    LISTEN CONFIGURATION (Network Interfaces)
    ============================================
    Define which ports and interfaces ClickHouse listens on
    -->
    <listen_host>::</listen_host>
    <!-- Alternative specific address: <listen_host>127.0.0.1</listen_host> -->

    <tcp_port>9000</tcp_port>              <!-- Native protocol (for client connections) -->
    <tcp_port_secure>9440</tcp_port_secure> <!-- Secure native protocol (TLS) -->
    <http_port>8123</http_port>             <!-- HTTP interface -->
    <http_port_secure>8443</http_port_secure> <!-- Secure HTTP interface (TLS) -->

    <!-- Optional: MySQL-compatible protocol (for MySQL clients) -->
    <mysql_port>3306</mysql_port>

    <!-- Optional: PostgreSQL-compatible protocol -->
    <postgresql_port>5432</postgresql_port>

    <!--
    ============================================
    INTERSERVER COMMUNICATION (Replication)
    ============================================
    Used for communication between servers in a cluster
    -->
    <interserver_http_host>localhost</interserver_http_host>
    <interserver_http_port>9009</interserver_http_port>
    <interserver_https_port>9010</interserver_https_port>

    <!-- Enable HTTPS for interserver communication -->
    <interserver_http_credentials>
        <user>interserver</user>
        <password>interserver_password</password>
    </interserver_http_credentials>

    <!--
    ============================================
    PATH CONFIGURATION
    ============================================
    Define where ClickHouse stores data, logs, temp files, etc.
    -->
    <path>/var/lib/clickhouse/</path>        <!-- Path for data storage -->
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path> <!-- Temporary storage -->
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>

    <!--
    ============================================
    USER CONFIGURATION
    ============================================
    References to user definitions (see users.xml)
    -->
    <users_config>users.xml</users_config>
    <access_control_path>/var/lib/clickhouse/access/</access_control_path>

    <!--
    ============================================
    MEMORY AND RESOURCE LIMITS
    ============================================
    Global server-level resource constraints
    -->

    <!-- Maximum memory usage (in bytes) for a single query -->
    <!-- 10GB example: 10737418240 -->
    <max_memory_usage>10737418240</max_memory_usage>

    <!-- Maximum memory usage for a single query on a server (same as max_memory_usage) -->
    <max_memory_usage_for_user>10737418240</max_memory_usage_for_user>

    <!-- Maximum memory usage for operations like sorting/grouping -->
    <max_execute_time_ms>600000</max_execute_time_ms>

    <!-- Number of threads to use for query processing -->
    <max_threads>16</max_threads>

    <!-- Maximum number of simultaneous connections -->
    <max_connections>4096</max_connections>

    <!-- Maximum number of concurrent queries -->
    <max_concurrent_queries>100</max_concurrent_queries>

    <!--
    ============================================
    LOGGING CONFIGURATION
    ============================================
    Control logging behavior and output
    -->
    <logger>
        <!-- Log file location -->
        <level>trace</level>  <!-- Options: trace, debug, information, warning, error -->
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>

        <!-- Log rotation parameters -->
        <size>1000M</size>     <!-- Rotate log when it reaches this size -->
        <count>10</count>      <!-- Keep this many rotated logs -->
    </logger>

    <!-- Detailed error logging in queries -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_time)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>

    <!-- Query thread logging (each thread creates a record) -->
    <query_thread_log>
        <database>system</database>
        <table>query_thread_log</table>
        <partition_by>toYYYYMM(event_time)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_thread_log>

    <!-- Trace logging for profiling -->
    <trace_log>
        <database>system</database>
        <table>trace_log</table>
        <partition_by>toYYYYMM(event_time)</partition_by>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </trace_log>

    <!--
    ============================================
    COMPRESSION SETTINGS
    ============================================
    Configure data compression for storage and network
    -->
    <compression>
        <!-- Default compression for new tables/columns -->
        <case>
            <method>lz4</method>  <!-- Options: lz4, zstd, lz4hc, deflate_qpl, disabled -->
        </case>
    </compression>

    <!-- Network compression settings -->
    <network_compression_method>lz4</network_compression_method>

    <!-- Minimum bytes to compress for network -->
    <network_zstd_compression_level>1</network_zstd_compression_level>

    <!--
    ============================================
    CLUSTER AND REPLICATION CONFIGURATION
    ============================================
    Define cluster topology for distributed queries and replication
    -->
    <remote_servers>
        <!-- Main production cluster: 3 shards × 2 replicas each -->
        <default>
            <!-- Shard 1 (2 replicas) -->
            <shard>
                <weight>1</weight>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse-1</host>
                    <port>9000</port>
                    <user>default</user>
                    <password></password>
                </replica>
                <replica>
                    <host>clickhouse-1-replica</host>
                    <port>9000</port>
                    <user>default</user>
                    <password></password>
                </replica>
            </shard>

            <!-- Shard 2 (2 replicas) -->
            <shard>
                <weight>1</weight>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse-2</host>
                    <port>9000</port>
                    <user>default</user>
                    <password></password>
                </replica>
                <replica>
                    <host>clickhouse-2-replica</host>
                    <port>9000</port>
                    <user>default</user>
                    <password></password>
                </replica>
            </shard>

            <!-- Shard 3 (2 replicas) -->
            <shard>
                <weight>1</weight>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse-3</host>
                    <port>9000</port>
                    <user>default</user>
                    <password></password>
                </replica>
                <replica>
                    <host>clickhouse-3-replica</host>
                    <port>9000</port>
                    <user>default</user>
                    <password></password>
                </replica>
            </shard>
        </default>

        <!-- Analytics cluster (simpler setup) -->
        <analytics>
            <shard>
                <replica>
                    <host>analytics-1</host>
                    <port>9000</port>
                </replica>
            </shard>
            <shard>
                <replica>
                    <host>analytics-2</host>
                    <port>9000</port>
                </replica>
            </shard>
        </analytics>
    </remote_servers>

    <!--
    ============================================
    ZOOKEEPER CONFIGURATION (Coordination Service)
    ============================================
    Configure ZooKeeper for leader election and distributed coordination
    Can be specified here or in metrika.xml
    -->
    <zookeeper>
        <node index="1">
            <host>zookeeper-1</host>
            <port>2181</port>
        </node>
        <node index="2">
            <host>zookeeper-2</host>
            <port>2181</port>
        </node>
        <node index="3">
            <host>zookeeper-3</host>
            <port>2181</port>
        </node>

        <!-- Session timeout (milliseconds) -->
        <session_timeout_ms>30000</session_timeout_ms>

        <!-- ZooKeeper operation timeout -->
        <operation_timeout_ms>10000</operation_timeout_ms>

        <!-- Retry timeout for operations -->
        <retry_timeout_ms>5000</retry_timeout_ms>
    </zookeeper>

    <!--
    ============================================
    DISTRIBUTED DDL SETTINGS
    ============================================
    Configuration for ON CLUSTER DDL queries
    -->
    <distributed_ddl>
        <!-- ZooKeeper path for distributed DDL -->
        <path>/clickhouse/task_queue/ddl</path>

        <!-- Profile to use for executing DDL -->
        <profile>default</profile>
    </distributed_ddl>

    <!--
    ============================================
    MACROS (Used for Replication)
    ============================================
    These can be referenced in table definitions
    Individual macros are typically in macros.xml file
    -->
    <include_from>macros.xml</include_from>

    <!--
    ============================================
    TABLE ENGINES AND DATABASE SETTINGS
    ============================================
    Configuration for different table engine types
    -->

    <!-- ReplicatedMergeTree settings -->
    <replicated_merge_tree>
        <!-- Number of threads for replication -->
        <background_pool_size>16</background_pool_size>

        <!-- Replicated fetches background tasks -->
        <background_fetches_pool_size>3</background_fetches_pool_size>

        <!-- Maximum bytes to download for replication per second (0 = unlimited) -->
        <replicated_max_parallel_sends_for_table>5</replicated_max_parallel_sends_for_table>

        <!-- Maximum bytes to upload for replication per second -->
        <replicated_max_parallel_fetches_for_table>5</replicated_max_parallel_fetches_for_table>
    </replicated_merge_tree>

    <!--
    ============================================
    SOCKET SETTINGS
    ============================================
    Low-level network configuration
    -->
    <tcp_keep_alive_timeout>30</tcp_keep_alive_timeout>
    <http_keep_alive_timeout>10</http_keep_alive_timeout>

    <!--
    ============================================
    MERGE CONFIGURATION
    ============================================
    Settings for background merges
    -->
    <merge_tree>
        <!-- Number of threads for MergeTree merges -->
        <background_pool_size>16</background_pool_size>

        <!-- Number of threads for moves/mutations -->
        <background_move_pool_size>8</background_move_pool_size>

        <!-- Number of threads for TTL operations -->
        <background_merges_mutations_concurrency_ratio>2</background_merges_mutations_concurrency_ratio>
    </merge_tree>

    <!--
    ============================================
    STORAGE POLICY
    ============================================
    Define different tiers of storage
    -->
    <storage_configuration>
        <disks>
            <!-- Hot storage (SSD) -->
            <hot>
                <path>/mnt/ssd/clickhouse/</path>
                <keep_free_space_bytes>10737418240</keep_free_space_bytes>
            </hot>

            <!-- Cold storage (HDD) -->
            <cold>
                <path>/mnt/hdd/clickhouse/</path>
                <keep_free_space_bytes>10737418240</keep_free_space_bytes>
            </cold>
        </disks>

        <policies>
            <!-- Default policy: use hot storage -->
            <default>
                <volumes>
                    <volume>
                        <disk>hot</disk>
                    </volume>
                </volumes>
            </default>

            <!-- Tiered policy: hot then cold -->
            <tiered>
                <volumes>
                    <volume>
                        <disk>hot</disk>
                        <max_data_part_size_bytes>1099511627776</max_data_part_size_bytes>
                        <move_factor>0.1</move_factor>
                    </volume>
                    <volume>
                        <disk>cold</disk>
                    </volume>
                </volumes>
            </tiered>
        </policies>
    </storage_configuration>

    <!--
    ============================================
    DICTIONARIES
    ============================================
    External dictionary configuration
    -->
    <dictionaries_config>dictionaries/*.xml</dictionaries_config>
    <user_defined_executable_functions_config>user_defined/functions/*.xml</user_defined_executable_functions_config>

    <!--
    ============================================
    FORMAT SETTINGS
    ============================================
    Default settings for various data formats
    -->
    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>

    <!--
    ============================================
    DATABASE ENGINES
    ============================================
    Default database engine configuration
    -->
    <default_database_engine>Atomic</default_database_engine>

    <!--
    ============================================
    QUERY PROCESSING SETTINGS
    ============================================
    -->
    <!-- Enable group by overflow -->
    <max_rows_in_set>0</max_rows_in_set>

    <!-- Maximum set size for joins -->
    <max_bytes_in_set>0</max_bytes_in_set>

    <!-- Limit for GROUP BY clauses -->
    <max_rows_to_group_by>0</max_rows_to_group_by>

    <!--
    ============================================
    SECURITY SETTINGS
    ============================================
    -->
    <!-- Enable/disable certain features -->
    <allow_introspection_functions>false</allow_introspection_functions>

    <!-- Enable/disable Uncompress functions on not compressed data -->
    <enable_uncompressed_cache>true</enable_uncompressed_cache>

    <!--
    ============================================
    OPENTELEMETRY CONFIGURATION
    ============================================
    -->
    <opentelemetry>
        <enabled>false</enabled>
        <endpoint_for_metrics></endpoint_for_metrics>
        <endpoint_for_traces></endpoint_for_traces>
    </opentelemetry>

</yandex>
