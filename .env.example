# Notion API Configuration
# Copy this file to .env and fill in your values

# Your Notion Integration Token (starts with secret_)
# Get it from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_your_integration_token_here

# Your Notion Database ID (32 character string)
# Found in your database URL: https://notion.so/workspace/DATABASE_ID?v=...
NOTION_DATABASE_ID=your_database_id_here
